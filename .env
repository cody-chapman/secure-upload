# Copy this file to .env and fill in real values. Never commit .env.

# Shared secret the PWA must present (as a Bearer token or ?key= query param).
# Generate something long and random, e.g.: openssl rand -hex 32
API_KEY=<apikey here>

# Port the server listens on
PORT=3000

# Absolute or relative path where uploaded photos are written.
# Subfolders are created automatically as: UPLOAD_DIR/<employeeNumber>/<YYYY-MM-DD>/
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to call this API.
# Use the exact origin the PWA is served from.
# Use * only for local testing.
CORS_ORIGIN=*

# Max upload size in megabytes
MAX_FILE_MB=25

# Serve the PWA (pwa/ folder) from this same Node server. Set to false if you're
# hosting the front-end separately (e.g. IIS, nginx, static hosting).
SERVE_STATIC=false

# Only used when SERVE_STATIC=true. Defaults to ../pwa relative to this server.
# STATIC_DIR=../pwa
